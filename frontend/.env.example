# ── Vite / Frontend ───────────────────────────────────────────────────────────
# All variables MUST be prefixed with VITE_ to be exposed to the browser

# Default RPC endpoint (used if MetaMask is not available)
VITE_RPC_URL=http://127.0.0.1:8545

# Default chain ID (31337 = Hardhat local, 1337 = Ganache)
VITE_CHAIN_ID=31337

